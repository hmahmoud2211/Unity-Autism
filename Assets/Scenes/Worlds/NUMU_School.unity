  scenarioId: school_lina_nervous
  world: school
  introToast: It's story time! Lina is at the front of the class. Go and see her.
  doneToast: Lina feels braver now. Look around the classroom, or tap Map to go back.
  playerName: You
  actors:
  - name: Lina
    npc: {fileID: 473607379}
    face: {fileID: 473607378}
    faceAnchor: {fileID: 473607375}
    turnToPlayer: 1
    shotDistance: 1.1
  - name: Ms. Sara
    npc: {fileID: 1468378062}
    face: {fileID: 1468378061}
    faceAnchor: {fileID: 1468378058}
    turnToPlayer: 1
    shotDistance: 1.4
  steps:
  - kind: 0
    actor: 1
    text: Lina, it's your turn to read your story to the class.
    emotion: 0
    strength: 1
    state: 
    options: []
    correctOption: 0
    praiseTitle: Yes, that's right!
    praise: 
    hint: 
    seconds: 1
  - kind: 1
    actor: 0
    text: 
    emotion: 4
    strength: 0.95
    state: 
    options: []
    correctOption: 0
    praiseTitle: Yes, that's right!
    praise: 
