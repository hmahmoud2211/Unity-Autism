  steps:
  - kind: 0
    actor: 1
    text: Lina, it's your turn to read your story to the class.
    emotion: 0
    strength: 1
    state: 
    options: []
    correctOption: 0
    praiseTitle: Yes, that's right!
    praise: 
    hint: 
    seconds: 1
  - kind: 1
    actor: 0
    text: 
