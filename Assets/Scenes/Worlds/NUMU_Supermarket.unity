  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Numu.World.NumuConversationScenario
  scenarioId: market_checkout
  world: supermarket
  introToast: Time to pay! Find checkout 1 and join the line.
  doneToast: Well done! You waited your turn and greeted the cashier. Tap Map to go back.
  playerName: You
  actors:
