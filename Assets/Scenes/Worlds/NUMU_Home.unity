  scenarioId: home_mum_sad
  world: home
  introToast: Mum is at the dining table. Go and talk to her.
  doneToast: Mum feels better now. Keep exploring your home, or tap Map to go back.
  playerName: You
  openWithGroupShot: 0
  actors:
  - name: Mum
    npc: {fileID: 234930680}
    face: {fileID: 234930679}
    faceAnchor: {fileID: 234930676}
