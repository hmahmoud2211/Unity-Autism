  scenarioId: home_mum_sad
  world: home
  introToast: Mum is at the dining table. Go and talk to her.
  doneToast: Mum feels better now. Keep exploring your home, or tap Map to go back.
  playerName: You
  actors:
  - name: Mum
    npc: {fileID: 1273788681}
    face: {fileID: 1273788680}
    faceAnchor: {fileID: 1273788677}
    turnToPlayer: 0
    shotDistance: 1.2
  steps:
  - kind: 1
    actor: 0
    text: 
    emotion: 2
    strength: 1
    state: 
    options: []
    correctOption: 0
    praiseTitle: Yes, that's right!
    praise: 
    hint: 
    seconds: 1
  - kind: 0
    actor: 0
    text: Oh... hello, sweetheart.
    emotion: 0
    strength: 1
    state: 
    options: []
    correctOption: 0
    praiseTitle: Yes, that's right!
    praise: 
    hint: 
    seconds: 1
  - kind: 0
    actor: 0
    text: My favourite cup fell and broke. Grandma gave it to me.
    emotion: 0
    strength: 1
    state: 
    options: []
    correctOption: 0
    praiseTitle: Yes, that's right!
    praise: 
    hint: 
    seconds: 1
  - kind: 3
    actor: 0
    text: How is Mum feeling?
    emotion: 2
    strength: 1
    state: 
    options: []
    correctOption: 0
    praiseTitle: Yes, that's right!
    praise: Mum is sad. The middle of her eyebrows goes up and the corners of her mouth go down.
    hint: Let's look again. Mum's mouth turns down and she is looking at her broken cup. Is that a happy face?
    seconds: 1
  - kind: 4
    actor: 0
    text: Mum is sad. What could you do?
    emotion: 0
    strength: 1
    state: 
    options:
    - label: Give Mum a hug
      icon: {fileID: 114081545240365436, guid: 6ce3b01f573b740d091703c23b3273c3, type: 3}
      color: {r: 1, g: 0.88235295, b: 0.91764706, a: 1}
    - label: Laugh at the cup
      icon: {fileID: -661642422251089062, guid: 3f2fc40b72151487bb608a79360b9d5f, type: 3}
      color: {r: 1, g: 0.94509804, b: 0.72156864, a: 1}
    - label: Walk away
      icon: {fileID: 1751989451324975719, guid: 601d6ab3f7ab44a9ca3c25fc9d8ef5af, type: 3}
      color: {r: 0.9098039, g: 0.9019608, b: 0.9411765, a: 1}
    - label: Shout
      icon: {fileID: -365116588634130010, guid: 43dedd82599b54b7fbd5112490dffd1c, type: 3}
      color: {r: 1, g: 0.8627451, b: 0.8392157, a: 1}
    correctOption: 0
    praiseTitle: That's so kind!
    praise: A hug shows Mum that you care. Kindness helps people feel better when they are sad.
    hint: Laughing, walking away or shouting won't help Mum feel better. What would show her that you care?
    seconds: 1
  - kind: 0
    actor: -1
    text: Are you okay, Mum? Here's a big hug!
    emotion: 0
    strength: 1
    state: 
    options: []
    correctOption: 0
